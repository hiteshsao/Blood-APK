# LifeDrop Mobile API Configuration Example
# Copy this to .env and change EXPO_PUBLIC_API_URL to your backend host.
#
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# Real Physical Phone (Wi-Fi LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
#
# Web / iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8080

EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
