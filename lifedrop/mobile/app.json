{
  "expo": {
    "name": "LifeDrop",
    "slug": "lifedrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/blood.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF5F5",
    "splash": {
      "image": "./assets/blood.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifedrop.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LifeDrop needs your location to connect you with nearby blood donors and recipients."
      }
    },
    "android": {
      "package": "com.lifedrop.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/blood.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY_PLACEHOLDER"
        }
      }
    },
    "web": {
      "favicon": "./assets/blood.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LifeDrop needs your location to connect you with nearby blood donors and recipients."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/blood.png",
          "color": "#DC2626"
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "2823636c-bd11-46ba-9c97-79e11d0f3dbc"
      }
    }
  }
}